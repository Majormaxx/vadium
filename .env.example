# Vadium environment. Copy to .env and fill in. NEVER commit .env.

# RPC endpoints (foundry.toml [rpc_endpoints])
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
UNICHAIN_RPC=https://mainnet.unichain.org
REACTIVE_LASNA_RPC=https://lasna-rpc.rnk.dev/
REACTIVE_RPC=https://mainnet-rpc.rnk.dev/

# Deployer / broadcaster. Testnet only for an EOA you keep in a file; on mainnet the
# deployer is a throwaway EOA and ownership is offered to OWNER (a Safe).
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
OWNER=

# Pool price for Deploy.s.sol (sqrtPriceX96). Required on mainnet.
INITIAL_SQRT_PRICE=

# Roles for Wire.s.sol
KEEPER=
WATCHTOWER=
REACTIVE_RVM=

# Explorer verification (Etherscan API v2 key works for Unichain 130 and 1301)
ETHERSCAN_API_KEY=

# Reactive sidecar (DeployReactive.s.sol)
ORIGIN_CHAIN_ID=1301
VADIUM_HOOK_ADDRESS=
REACTIVE_FUND_WEI=2000000000000000000
CALLBACK_GAS_LIMIT=300000

# Liquidity seeding (AddLiquidity.s.sol)
LIQUIDITY_DELTA=1000000
ETH_BUDGET_WEI=10000000000000000
ROUTER=
