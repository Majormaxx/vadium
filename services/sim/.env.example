# Vadium sim. Copy to .env and fill in. NEVER commit .env.

# JSON-RPC endpoint and chain. The deployment record is looked up by CHAIN_ID.
RPC_URL=https://sepolia.unichain.org
CHAIN_ID=1301

# Key that owns every SimSwapRouter, pays for swaps and bonds, and receives outputs.
# Required for `run --execute`; optional for `plan` and dry runs (a read-only address
# can be given with SIM_ADDRESS instead).
SIM_PRIVATE_KEY=
SIM_ADDRESS=

# Swap-input budgets across every leg of the selected scenarios. Bonds are sized by the
# hook's minBond and sit outside these budgets.
USDC_BUDGET=20000000
ETH_BUDGET_WEI=1000000000000000

# Fraction of the pool's virtual reserve each leg moves, in basis points. Larger legs
# make the clamp and the victim loss visible; too large and one leg drains the pool.
SWAP_FRACTION_BPS=500

# Comma-separated subset of: unbonded-sandwich,unbonded-mule,bonded-sandwich,bonded-arb-follower
SCENARIOS=

# Gas limit for each swap in a same-block batch (not estimated, so the three legs sign
# without waiting on each other).
SWAP_GAS_LIMIT=1500000
