# Copy to .env.local (Ponder loads .env.local automatically). Never commit .env files.

# Active chain: 1301 (Unichain Sepolia) or 130 (Unichain mainnet). Must have a
# record in generated/deployments.json.
CHAIN_ID=1301

# RPC endpoints per chain id. Public defaults are used when unset.
PONDER_RPC_URL_1301=https://sepolia.unichain.org
PONDER_RPC_URL_130=https://mainnet.unichain.org

# Postgres connection string. Leave unset to use the embedded PGlite database
# under .ponder/.
# DATABASE_URL=postgres://user:pass@host:5432/vadium

# HTTP port for the API (Ponder default 42069).
# PORT=42069
