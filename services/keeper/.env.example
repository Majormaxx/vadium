# JSON-RPC endpoint. Defaults to the chain's public RPC when unset.
RPC_URL=https://sepolia.unichain.org

# 1301 = Unichain Sepolia, 130 = Unichain mainnet.
CHAIN_ID=1301

# Private key of the address set as keeper() on the hook. Required.
KEEPER_PRIVATE_KEY=0x

# Comma-separated pool ids (bytes32). Defaults to the poolId in generated/deployments.json for CHAIN_ID.
#POOL_IDS=0x...

# Seconds between drain ticks.
DRAIN_INTERVAL_S=3600

# Largest amount paid out per pool per tick, in bond-token raw units (6 decimals).
DRAIN_CAP=1000000000

# Smallest reserve worth paying out, in bond-token raw units.
MIN_DRAIN=1000000

# HTTP port for /metrics, /status and /healthz.
METRICS_PORT=9464

# Where flagged addresses and the last scanned block are persisted.
STATE_FILE=./state.json

# First block to scan on a fresh state file. Defaults to the deploy block in deployments.json.
#START_BLOCK=

# Blocks per eth_getLogs call during backfill and live polling.
BACKFILL_STEP=2000

# debug, info, warn or error.
LOG_LEVEL=info
