# Indexer API base URL. The site reads every list and history from here.
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069

# Chain the site reads on-chain numbers from. 1301 = Unichain Sepolia, 130 = Unichain.
NEXT_PUBLIC_CHAIN_ID=1301

# JSON-RPC endpoint for that chain.
NEXT_PUBLIC_RPC_URL=https://sepolia.unichain.org

# Public URL of this site, used for Open Graph image links. On Vercel it is
# taken from VERCEL_PROJECT_PRODUCTION_URL when unset.
# NEXT_PUBLIC_SITE_URL=https://vadium.example

# Overrides the hook address from src/generated/deployments.json. Set it when
# the build has no forge artifacts (a plain Vercel checkout, for example).
# NEXT_PUBLIC_HOOK_ADDRESS=0x6d6201097d6549F9760d61019E69E599315dc0C0
