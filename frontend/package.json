{
  "name": "vadium-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Vadium status site: read-only view of the hook's pools, bonds, slashes, and refunds.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand": "node scripts/export-brand.mjs",
    "abis": "node ../scripts/export-artifacts.mjs && node scripts/check-abi.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "sharp": "^0.35.4",
    "png-to-ico": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
